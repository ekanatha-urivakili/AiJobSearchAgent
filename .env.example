JOB_SEARCH_TIME_ZONE=Europe/London
JOB_SEARCH_RUN_AT=10:00
JOB_SEARCH_POSTCODE="MK4 4QG"
JOB_SEARCH_RADIUS_MILES=50
JOB_SEARCH_POSTED_WITHIN_DAYS=7
JOB_SEARCH_MIN_PERMANENT_SALARY_GBP=75000
JOB_SEARCH_MIN_CONTRACT_DAY_RATE_GBP=400
JOB_SEARCH_MIN_CONTRACT_MONTHS=6
POSTGRES_DB=ai_job_search_agent
POSTGRES_USER=ai_job_search_agent
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://ai_job_search_agent:change-me-local-only@postgres:5432/ai_job_search_agent
SETTINGS_ENCRYPTION_KEY=
REED_API_KEY=<generate a new API key from Reed and replace this placeholder: https://www.reed.co.uk/developers/jobseeker>

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# Gmail Integration
GMAIL_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", ...}
GMAIL_USER_EMAIL=you@your-domain.com
GMAIL_SEARCH_QUERY="label:job-alerts is:unread"
# Indeed Integration (via Gmail job alert emails)
# Set GMAIL_CREDENTIALS_JSON and GMAIL_USER_EMAIL (above) to enable. Override the search query to target Indeed alert emails.
INDEED_GMAIL_SEARCH_QUERY="from:jobalerts-noreply@indeed.com is:unread"
